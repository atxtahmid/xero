// IMPORTANT: this is a COPY of bot/prisma/schema.prisma. This service
// runs as a separate deployable from the bot (its own package.json, own
// node_modules, own generated Prisma Client) but reads/writes the SAME
// Postgres database via the same DATABASE_URL. Prisma requires each
// service to generate its own client from its own schema file — there's
// no way to share one schema.prisma across two independent npm projects
// without a monorepo/workspace setup, which the bot doesn't currently
// use. Whenever bot/prisma/schema.prisma changes, copy those changes
// here too, or this service's Prisma Client will drift out of sync with
// the real table shape and either miss new columns or error on writes.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PunishmentType {
  REMOVE_ROLES
  TIMEOUT
  KICK
  BAN
}

// Stores Discord OAuth access/refresh tokens server-side, never sent to
// the browser — the JWT issued to the frontend only ever contains a
// reference to a row here, not the real Discord token itself. This
// table is ALSO declared in the bot's own schema.prisma (bot never
// reads/writes it, but its `prisma db push` would otherwise try to drop
// it — see the comment there). Keep both copies identical.
model DashboardSession {
  id           String   @id @default(cuid())
  userId       String
  accessToken  String   @db.Text
  refreshToken String   @db.Text
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

enum ModerationAction {
  WARN
  KICK
  BAN
  SOFT_BAN
  TEMP_BAN
  TIMEOUT
  TIMEOUT_REMOVED
}

enum TicketStatus {
  OPEN
  LOCKED
  CLOSED
}

enum TicketCategoryType {
  GENERAL
  SUPPORT
  REPORT
  APPEAL
  OTHER
}

model User {
  id               String        @id
  username         String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  chatHistory      ChatHistory[]
  warnings         Warning[]
  cases            Case[]        @relation("CaseTarget")
  moderatedCases   Case[]        @relation("CaseModerator")
  createdTickets   Ticket[]      @relation("TicketCreator")
  playlists        Playlist[]
}

model Playlist {
  id          String         @id @default(cuid())
  ownerId     String
  owner       User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  name        String
  tracks      PlaylistTrack[]

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([ownerId, name])
  @@index([ownerId])
}

model PlaylistTrack {
  id          String   @id @default(cuid())
  playlistId  String
  playlist    Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)

  // Lavalink's base64 track "encoded" string — enough to hand straight
  // back to the node without re-resolving the source on load.
  encoded     String   @db.Text
  title       String
  author      String
  uri         String?
  durationMs  Int
  position    Int

  createdAt   DateTime @default(now())

  @@index([playlistId])
}

model Guild {
  id                 String               @id
  prefix             String               @default("!")
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  settings           GuildSettings?
  chatHistory        ChatHistory[]
  warnings           Warning[]
  cases              Case[]
  antiNukeSettings   AntiNukeSettings?
  coOwners           AntiNukeCoOwner[]
  lockdown           AntiNukeLockdown?
  tempBans           TempBan[]
  giveaways          Giveaway[]
  tickets            Ticket[]
  ticketPanels       TicketPanel[]
}

model GuildSettings {
  id                 String   @id @default(cuid())
  guildId            String   @unique
  guild              Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  language           String   @default("en")
  aiEnabled          Boolean  @default(true)
  aiModel            String   @default("gemini-1.5-flash")

  logChannelId            String?
  serverLogChannelId      String?
  antiNukeLogChannelId    String?
  // AI Logs — audit trail of /chat usage (who, where, what was asked,
  // whether search was used). Separate channel from the others so a
  // server can route AI usage monitoring somewhere different from
  // general server activity.
  aiLogChannelId          String?
  welcomeChannelId        String?
  welcomeMessage          String?
  leaveMessage            String?

  autoRoleId         String?
  modRoleId          String?
  adminRoleId        String?

  // Music — DJ role gates skip/stop/volume/loop/shuffle/remove/clear/seek/
  // filters when set. Null means "anyone in the same voice channel as the
  // bot may control playback" (see utils/musicChecks.ts).
  djRoleId           String?
  musicDefaultVolume Int      @default(100)

  // Owner Bypass system — see utils/ownerTrust.ts. Null means "trust
  // whoever Discord says is the real guild.ownerId" (the normal case).
  // Only the bot's global owner can set this, via /owner-bypass claim,
  // for exactly one scenario: the real owner's Discord account is
  // compromised. Discord itself still lets that account act with full
  // owner power directly in the Discord client — nothing here changes
  // that — but every trust decision THIS BOT makes (Anti-Nuke's owner
  // exemption, isHighlyTrusted(), command permission bypasses) switches
  // to trusting this ID instead, and the original owner ID is treated as
  // a completely ordinary member everywhere this bot checks trust.
  trustedOwnerId     String?

  searchEnabled      Boolean  @default(true)

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model ChatHistory {
  id          String   @id @default(cuid())
  userId      String
  guildId     String
  role        String
  content     String   @db.Text
  createdAt   DateTime @default(now())

  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  guild        Guild   @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([guildId])
}

model Warning {
  id            String   @id @default(cuid())
  guildId       String
  userId        String
  moderatorId   String
  reason        String   @db.Text
  createdAt     DateTime @default(now())

  guild         Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([guildId])
  @@index([userId])
}

model Case {
  id            String             @id @default(cuid())
  guildId       String
  userId        String
  moderatorId   String
  action        ModerationAction
  reason        String             @db.Text
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  guild         Guild              @relation(fields: [guildId], references: [id], onDelete: Cascade)
  user          User               @relation("CaseTarget", fields: [userId], references: [id], onDelete: Cascade)
  moderator     User               @relation("CaseModerator", fields: [moderatorId], references: [id], onDelete: Cascade)

  @@index([guildId])
  @@index([userId])
  @@index([moderatorId])
  @@index([action])
}

model AntiNukeSettings {
  id                    String           @id @default(cuid())
  guildId               String           @unique
  guild                 Guild            @relation(fields: [guildId], references: [id], onDelete: Cascade)

  enabled               Boolean          @default(true)
  antiMassBan           Boolean          @default(true)
  antiMassKick          Boolean          @default(true)
  antiChannelDelete     Boolean          @default(true)
  antiChannelCreate     Boolean          @default(true)
  antiChannelUpdate     Boolean          @default(true)
  antiRoleDelete        Boolean          @default(true)
  antiRoleCreate        Boolean          @default(true)
  antiRoleUpdate        Boolean          @default(true)
  antiBotAdd            Boolean          @default(true)
  antiWebhookCreate     Boolean          @default(true)
  antiServerUpdate      Boolean          @default(true)

  botAddThreshold        Int @default(1)
  massBanThreshold       Int @default(2)
  massKickThreshold      Int @default(2)
  channelDeleteThreshold Int @default(3)
  channelCreateThreshold Int @default(5)
  channelUpdateThreshold Int @default(5)
  roleDeleteThreshold    Int @default(2)
  roleCreateThreshold    Int @default(5)
  roleUpdateThreshold    Int @default(5)
  webhookCreateThreshold Int @default(1)
  serverUpdateThreshold  Int @default(1)

  punishment            PunishmentType   @default(REMOVE_ROLES)

  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
}

model AntiNukeCoOwner {
  id         String   @id @default(cuid())
  guildId    String
  userId     String
  guild      Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([guildId, userId])
  @@index([guildId])
}

model TempBan {
  id          String   @id @default(cuid())
  guildId     String
  // Deliberately plain strings, not User relations — this table only
  // needs the raw Discord IDs to call guild.bans.remove(userId) later.
  // Adding a User foreign key here would reintroduce the exact FK-safety
  // problem just fixed in caseService.ts/warningService.ts, for no
  // actual benefit (nothing here needs to join against User data).
  userId      String
  moderatorId String
  reason      String   @db.Text
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  guild       Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, userId])
  @@index([expiresAt])
}

model Giveaway {
  id                String   @id @default(cuid())
  guildId           String
  channelId         String
  messageId         String   @unique
  hostId            String
  prize             String
  winnerCount       Int      @default(1)
  endsAt            DateTime
  ended             Boolean  @default(false)

  // All optional and independent — a giveaway can use any combination
  // of these, or none. Enforced both at entry time (disqualifying
  // reactions get removed immediately with a DM explaining why) and
  // again at draw time (defense in depth in case someone qualified when
  // they reacted but no longer does by the time the giveaway ends, e.g.
  // a required role was removed from them).
  requiredRoleId    String?
  minAccountAgeDays Int?
  minServerJoinDays Int?

  winnerIds         String[] @default([])

  createdAt         DateTime @default(now())

  guild             Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId])
  @@index([endsAt])
}

model AntiNukeLockdown {
  id               String   @id @default(cuid())
  guildId          String   @unique
  guild            Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  active           Boolean  @default(false)
  reason           String
  // Snapshot of { [roleId]: "permissionBitfieldString" } taken the moment
  // lockdown engages, used to restore every stripped role exactly as it
  // was once lockdown lifts.
  rolePermissions  Json     @default("{}")

  triggeredAt      DateTime @default(now())
  // Updated every time another Anti-Nuke event fires while lockdown is
  // already active — the auto-lift scheduler only disengages once this
  // has gone untouched for the full cooldown window.
  lastTriggerAt    DateTime @default(now())

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model AntiNukeWhitelist {
  id         String   @id @default(cuid())
  guildId    String
  userId     String
  category   String
  createdAt  DateTime @default(now())

  @@unique([guildId, userId, category])
  @@index([guildId])
  @@index([userId])
}

model GuildBackup {
  id        String   @id @default(cuid())
  guildId   String
  createdAt DateTime @default(now())
  roles     RoleBackup[]
  channels  ChannelBackup[]

  @@index([guildId])
}

model RoleBackup {
  id            String   @id @default(cuid())
  backupId      String
  backup        GuildBackup @relation(fields: [backupId], references: [id], onDelete: Cascade)
  roleId        String
  name          String
  color         Int
  permissions   String
  position      Int
  hoist         Boolean
  mentionable   Boolean
  createdAt     DateTime @default(now())

  @@index([backupId])
}

model ChannelBackup {
  id            String   @id @default(cuid())
  backupId      String
  backup        GuildBackup @relation(fields: [backupId], references: [id], onDelete: Cascade)
  channelId     String
  parentId      String?
  name          String
  type          Int
  position      Int
  topic         String?
  nsfw          Boolean
  overwrites    ChannelPermissionOverwrite[]
  createdAt     DateTime @default(now())

  @@index([backupId])
}

model ChannelPermissionOverwrite {
  id         String   @id @default(cuid())
  channelId  String
  targetId   String
  type       Int
  allow      String
  deny       String
  createdAt  DateTime @default(now())
  channel    ChannelBackup @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId])
}

model TicketPanel {
  id              String   @id @default(cuid())
  guildId         String
  guild           Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  channelId       String
  messageId       String?
  supportRoleId   String?
  categoryId      String?
  logChannelId    String?
  name            String   @default("Support")
  description     String?
  color           Int      @default(5793266)

  tickets         Ticket[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([guildId, channelId])
  @@index([guildId])
}

model Ticket {
  id              String             @id @default(cuid())
  guildId         String
  guild           Guild              @relation(fields: [guildId], references: [id], onDelete: Cascade)

  panelId         String
  panel           TicketPanel        @relation(fields: [panelId], references: [id], onDelete: Cascade)

  channelId       String             @unique
  creatorId       String
  creator         User               @relation("TicketCreator", fields: [creatorId], references: [id], onDelete: Cascade)

  claimedById     String?
  category        TicketCategoryType @default(GENERAL)
  status          TicketStatus       @default(OPEN)
  transcriptUrl   String?

  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  closedAt        DateTime?

  @@index([guildId])
  @@index([creatorId])
  @@index([status])
}