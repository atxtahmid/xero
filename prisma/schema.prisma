generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PunishmentType {
  REMOVE_ROLES
  TIMEOUT
  KICK
  BAN
}

model User {
  id           String        @id
  username     String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  chatHistory  ChatHistory[]
  warnings     Warning[]
}

model Guild {
  id                 String               @id
  prefix             String               @default("!")
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  settings           GuildSettings?
  chatHistory        ChatHistory[]
  warnings           Warning[]
  antiNukeSettings   AntiNukeSettings?
  coOwners           AntiNukeCoOwner[]
}

model GuildSettings {
  id                 String   @id @default(cuid())

  guildId            String   @unique
  guild              Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  language           String   @default("en")
  aiEnabled          Boolean  @default(true)
  aiModel            String   @default("gemini-2.5-flash")

  logChannelId            String?
  antiNukeLogChannelId    String?
  welcomeChannelId        String?
  welcomeMessage          String?
  leaveMessage            String?

  autoRoleId         String?
  modRoleId          String?
  adminRoleId        String?

  searchEnabled      Boolean  @default(true)

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model ChatHistory {
  id          String   @id @default(cuid())

  userId      String
  guildId     String

  role        String
  content     String   @db.Text

  createdAt   DateTime @default(now())

  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  guild        Guild   @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([guildId])
}

model Warning {
  id            String   @id @default(cuid())

  guildId       String
  userId        String

  moderatorId   String
  reason        String   @db.Text

  createdAt     DateTime @default(now())

  guild         Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([guildId])
  @@index([userId])
}

model AntiNukeSettings {
  id                    String           @id @default(cuid())

  guildId               String           @unique
  guild                 Guild            @relation(fields: [guildId], references: [id], onDelete: Cascade)

  enabled               Boolean          @default(true)

  antiMassBan           Boolean          @default(true)
  antiMassKick          Boolean          @default(true)

  antiChannelDelete     Boolean          @default(true)
  antiChannelCreate     Boolean          @default(true)
  antiChannelUpdate     Boolean          @default(true)

  antiRoleDelete        Boolean          @default(true)
  antiRoleCreate        Boolean          @default(true)
  antiRoleUpdate        Boolean          @default(true)

  antiBotAdd            Boolean          @default(true)
  antiWebhookCreate     Boolean          @default(true)
  antiServerUpdate      Boolean          @default(true)

  botAddThreshold        Int @default(1)

  massBanThreshold       Int @default(2)
  massKickThreshold      Int @default(2)

  channelDeleteThreshold Int @default(3)
  channelCreateThreshold Int @default(5)
  channelUpdateThreshold Int @default(5)

  roleDeleteThreshold    Int @default(2)
  roleCreateThreshold    Int @default(5)
  roleUpdateThreshold    Int @default(5)

  webhookCreateThreshold Int @default(1)

  serverUpdateThreshold  Int @default(1)

  punishment            PunishmentType   @default(REMOVE_ROLES)

  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
}

model AntiNukeCoOwner {
  id         String   @id @default(cuid())

  guildId    String
  userId     String

  guild      Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())

  @@unique([guildId, userId])
  @@index([guildId])
}

model AntiNukeWhitelist {
  id         String   @id @default(cuid())

  guildId    String
  userId     String

  category   String

  createdAt  DateTime @default(now())

  @@unique([guildId, userId, category])

  @@index([guildId])
  @@index([userId])
}
model GuildBackup {
  id        String   @id @default(cuid())

  guildId   String
  createdAt DateTime @default(now())

  roles     RoleBackup[]
  channels  ChannelBackup[]

  @@index([guildId])
}

model RoleBackup {
  id            String   @id @default(cuid())

  backupId      String
  backup        GuildBackup @relation(fields: [backupId], references: [id], onDelete: Cascade)

  roleId        String
  name          String

  color         Int
  permissions   String

  position      Int
  hoist         Boolean
  mentionable   Boolean

  createdAt     DateTime @default(now())

  @@index([backupId])
}

model ChannelBackup {
  id            String   @id @default(cuid())

  backupId      String
  backup        GuildBackup @relation(fields: [backupId], references: [id], onDelete: Cascade)

  channelId     String
  parentId      String?

  name          String
  type          Int

  position      Int
  topic         String?
  nsfw          Boolean

  overwrites    ChannelPermissionOverwrite[]

  createdAt     DateTime @default(now())

  @@index([backupId])
}

model ChannelPermissionOverwrite {
  id         String   @id @default(cuid())

  channelId  String

  targetId   String
  type       Int

  allow      String
  deny       String

  createdAt  DateTime @default(now())

  channel    ChannelBackup @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId])
}